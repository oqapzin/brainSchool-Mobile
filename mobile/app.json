{
  "expo": {
    "name": "Blog Escolar - Pos Tech",
    "slug": "mobile-pos-blog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobileposblog",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
